---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { meta } = t[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(lang === 'ru' ? '/' : '/en/', Astro.site)} />
    <!-- Языковые версии: поисковики показывают нужную пользователю -->
    <link rel="alternate" hreflang="ru" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <!-- Предзагружаем шрифты первого экрана: основной текст и заголовок -->
    <Font cssVariable="--font-manrope" preload={[{ weight: 400, subset: lang === 'ru' ? 'cyrillic' : 'latin' }]} />
    <!-- Onest — один файл на все толщины (вариативный шрифт), фильтр по толщине к нему не применяется -->
    <Font cssVariable="--font-onest" preload />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2"
    >
      {lang === 'ru' ? 'Перейти к содержимому' : 'Skip to content'}
    </a>
    <slot />
  </body>
</html>
