---
// Нарисованный чат с ботом записи — вместо скриншота переписки (в нём были бы личные данные).
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t[lang].work.chat;
const times = [
  { time: '13:00', free: true },
  { time: '13:30', free: true },
  { time: '14:00', free: true },
  { time: '14:30', free: false },
  { time: '15:00', free: false },
  { time: '15:30', free: false },
  { time: '16:00', free: true },
  { time: '16:30', free: true },
];
---

<div class="flex h-full flex-col bg-[#0e1621] p-4 text-[13px] sm:p-5" aria-hidden="true">
  <div class="mb-4 flex items-center gap-3 border-b border-white/10 pb-3">
    <div class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-700 font-display font-bold text-white">Б</div>
    <div>
      <p class="font-semibold text-white">{c.bot}</p>
      <p class="text-xs text-sky-300/80">bot</p>
    </div>
  </div>

  <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-[#182533] px-3.5 py-2.5 text-white/90">
    <p class="font-semibold">{c.service}</p>
    <p class="mt-1 text-white/70">{c.pick}</p>
  </div>

  <div class="mt-2 grid max-w-[85%] grid-cols-4 gap-1.5">
    {times.map((s) => (
      <span
        class:list={[
          'rounded-lg py-1.5 text-center font-medium',
          s.free ? 'bg-[#2b5278] text-white' : 'bg-[#1c2733] text-white/55 line-through decoration-white/30',
        ]}
      >
        {s.time}
      </span>
    ))}
  </div>

  <div class="mt-auto ml-auto max-w-[70%] rounded-2xl rounded-tr-sm bg-[#2b5278] px-3.5 py-2 text-white">16:00</div>
  <div class="mt-2 max-w-[85%] rounded-2xl rounded-tl-sm bg-[#182533] px-3.5 py-2.5 font-semibold text-white">{c.done}</div>
</div>
