---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import BotChat from './BotChat.astro';
import { t, TELEGRAM, TELEGRAM_HANDLE, type Lang } from '../i18n';
import zernoImg from '../assets/projects/zerno.png';
import kvadratImg from '../assets/projects/kvadrat.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t[lang];

const projects = [
  {
    ...d.work.projects.zerno,
    image: zernoImg,
    links: [
      { label: d.work.site, href: 'https://zerno-coffee-landing.vercel.app' },
      { label: d.work.code, href: 'https://github.com/aagvan-byte/zerno-coffee-landing' },
    ],
  },
  {
    ...d.work.projects.kvadrat,
    image: kvadratImg,
    links: [
      { label: d.work.site, href: 'https://kvadrat-remont-site.vercel.app' },
      { label: d.work.code, href: 'https://github.com/aagvan-byte/kvadrat-remont-site' },
    ],
  },
  {
    ...d.work.projects.boroda,
    image: null,
    links: [
      { label: d.work.bot, href: 'https://t.me/dasddabbadcx_bot' },
      { label: d.work.code, href: 'https://github.com/aagvan-byte/barber-booking-bot' },
    ],
  },
];

const navLinks = [
  { href: '#services', label: d.nav.services },
  { href: '#work', label: d.nav.work },
  { href: '#process', label: d.nav.process },
  { href: '#about', label: d.nav.about },
];

const serviceIcons = [
  '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/>',
  '<rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/>',
  '<path d="M21 4 3 11l6 2 2 6 3-4 5 4z"/>',
  '<path d="M4 4h16v12H8l-4 4z"/><path d="M8 9h8M8 12h5"/>',
];

const tgIcon = '<path d="M21 4 3 11l6 2 2 6 3-4 5 4z"/>';
---

<Layout lang={lang}>
  <header class="sticky top-0 z-40 border-b border-line/80 bg-bg/80 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
      <a href={lang === 'ru' ? '/' : '/en/'} class="flex items-center gap-2.5" aria-label="Ambrosial">
        <img src="/favicon.svg" alt="" width="28" height="28" />
        <span class="font-display text-lg font-bold tracking-tight">Ambrosial</span>
      </a>
      <nav class="hidden md:block" aria-label={lang === 'ru' ? 'Навигация' : 'Navigation'}>
        <ul class="flex gap-7 text-sm font-medium text-muted">
          {navLinks.map((l) => <li><a href={l.href} class="transition-colors hover:text-ink">{l.label}</a></li>)}
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        <a
          href={d.switchTo.href}
          hreflang={d.switchTo.label.toLowerCase()}
          aria-label={`${d.switchTo.label} — ${d.switchTo.aria}`}
          class="flex h-10 items-center rounded-lg border border-line px-3 text-sm font-semibold text-muted transition-colors hover:border-muted hover:text-ink"
        >
          {d.switchTo.label}
        </a>
        <a
          href={TELEGRAM}
          target="_blank"
          rel="noopener"
          class="flex h-10 items-center gap-2 rounded-lg bg-accent px-4 text-sm font-semibold text-white transition-colors hover:bg-accent-hover"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" set:html={tgIcon} />
          <span>{d.nav.contact}</span>
        </a>
      </div>
    </div>
  </header>

  <main id="main">
    <!-- Первый экран -->
    <section class="relative overflow-hidden">
      <div class="grid-bg absolute inset-0 -z-10"></div>
      <div class="absolute top-0 left-1/2 -z-10 h-80 w-[40rem] -translate-x-1/2 rounded-full bg-accent/20 blur-3xl"></div>
      <div class="mx-auto max-w-6xl px-4 pt-20 pb-24 sm:px-6 md:pt-28 md:pb-32">
        <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm text-muted">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
          {d.hero.eyebrow} · Ambrosial
        </p>
        <h1 class="mt-6 max-w-4xl font-display text-4xl leading-[1.1] font-bold tracking-tight text-balance sm:text-6xl">
          {d.hero.title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{d.hero.lead}</p>
        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a
            href={TELEGRAM}
            target="_blank"
            rel="noopener"
            class="flex items-center justify-center gap-2.5 rounded-xl bg-accent px-7 py-4 font-semibold text-white shadow-lg shadow-accent/25 transition-colors hover:bg-accent-hover"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" set:html={tgIcon} />
            {d.hero.cta}
          </a>
          <a href="#work" class="rounded-xl border border-line px-7 py-4 text-center font-semibold transition-colors hover:border-muted">
            {d.hero.secondary}
          </a>
        </div>
      </div>
    </section>

    <!-- Услуги -->
    <section id="services" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{d.services.title}</h2>
        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {d.services.items.map((s, i) => (
            <li class="rounded-2xl border border-line bg-surface p-6">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent/15 text-accent-text">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={serviceIcons[i]} />
              </div>
              <h3 class="mt-5 font-display text-lg font-semibold">{s.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{s.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Работы -->
    <section id="work" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{d.work.title}</h2>
        <p class="mt-4 max-w-2xl text-lg text-muted">{d.work.lead}</p>

        <div class="mt-12 grid gap-8">
          {projects.map((p, i) => (
            <article class="grid overflow-hidden rounded-3xl border border-line bg-surface lg:grid-cols-2">
              <div class:list={[
                'relative overflow-hidden border-b border-line lg:aspect-auto lg:min-h-[22rem] lg:border-b-0',
                // Скриншоту хватает пропорции 16:10, чату на телефоне нужна высота, чтобы влезли все сообщения
                p.image ? 'aspect-[16/10]' : 'h-[23rem] lg:h-auto',
                i % 2 === 1 ? 'lg:order-2 lg:border-l' : 'lg:border-r',
              ]}>
                {p.image ? (
                  <Image
                    src={p.image}
                    alt={p.title}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 1024px) 560px, 100vw"
                    class="absolute inset-0 h-full w-full object-cover object-top"
                  />
                ) : (
                  <div class="absolute inset-0"><BotChat lang={lang} /></div>
                )}
              </div>
              <div class="flex flex-col p-6 sm:p-10">
                <span class="w-fit rounded-md border border-line px-2 py-0.5 text-xs font-semibold tracking-wide text-muted uppercase">{d.work.demo}</span>
                <h3 class="mt-4 font-display text-2xl font-bold tracking-tight">{p.title}</h3>
                <p class="mt-4 leading-relaxed text-muted">{p.text}</p>
                <ul class="mt-6 flex flex-wrap gap-2">
                  {p.tags.map((tag) => <li class="rounded-full bg-raised px-3 py-1 text-sm text-ink/80">{tag}</li>)}
                </ul>
                <div class="mt-auto flex flex-wrap gap-x-6 gap-y-3 pt-8">
                  {p.links.map((l, j) => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener"
                      class:list={['font-semibold transition-colors', j === 0 ? 'text-accent-text hover:text-ink' : 'text-muted hover:text-ink']}
                    >
                      {l.label} ↗
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Как работаю -->
    <section id="process" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{d.process.title}</h2>
        <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
          {d.process.steps.map((s, i) => (
            <li class="border-t-2 border-accent pt-5">
              <span class="font-display text-sm font-semibold text-accent-text">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-2 font-semibold">{s.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Обо мне -->
    <section id="about" class="border-t border-line">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 lg:grid-cols-[1.3fr_1fr]">
        <div>
          <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{d.about.title}</h2>
          {d.about.text.map((p) => <p class="mt-5 text-lg leading-relaxed text-muted">{p}</p>)}
        </div>
        <ul class="space-y-3 self-end">
          {d.about.principles.map((p) => (
            <li class="flex items-start gap-3 rounded-2xl border border-line bg-surface p-5">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" class="mt-0.5 shrink-0 text-accent-text" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Контакт -->
    <section id="contact" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
        <div class="relative overflow-hidden rounded-3xl border border-line bg-surface px-6 py-14 text-center sm:px-12">
          <div class="absolute -top-24 left-1/2 h-64 w-[36rem] -translate-x-1/2 rounded-full bg-accent/20 blur-3xl"></div>
          <h2 class="relative font-display text-3xl font-bold tracking-tight sm:text-4xl">{d.contact.title}</h2>
          <p class="relative mx-auto mt-5 max-w-xl text-lg leading-relaxed text-muted">{d.contact.text}</p>
          <a
            href={TELEGRAM}
            target="_blank"
            rel="noopener"
            class="relative mt-9 inline-flex items-center gap-2.5 rounded-xl bg-accent px-8 py-4 font-semibold text-white shadow-lg shadow-accent/25 transition-colors hover:bg-accent-hover"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" set:html={tgIcon} />
            {d.contact.cta}
          </a>
          <p class="relative mt-4 text-sm text-muted">{TELEGRAM_HANDLE}</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-8 text-sm text-muted sm:flex-row sm:px-6">
      <p>© {new Date().getFullYear()} Ambrosial · {d.footer}</p>
      <a href={TELEGRAM} target="_blank" rel="noopener" class="hover:text-ink">{TELEGRAM_HANDLE}</a>
    </div>
  </footer>
</Layout>
